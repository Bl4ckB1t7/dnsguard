APP_ENV=development
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_ENABLED=false
DNS_NODE_ADDRESSES=primary-1=DNS_PRIMARY:53,secondary-1=DNS_SECONDARY_1:53,secondary-2=DNS_SECONDARY_2:53
DNS_NODE_CONFIG_FILE=/etc/dns-ops/dns-nodes.json
RPZ_LOG_FILES=/var/log/named/rpz.log
RPZ_HIT_DEDUP_SECONDS=2
# For direct HTTPS. If TLS terminates at a reverse proxy, use TRUST_PROXY_TLS=true instead.
TLS_CERT_FILE=/etc/dns-ops/tls/fullchain.pem
TLS_KEY_FILE=/etc/dns-ops/tls/privkey.pem
TRUST_PROXY_TLS=false
LISTEN_ADDR=127.0.0.1:8080
DNS_STATE_FILE=/data/dns-state.json
AUDIT_FILE=/data/audit.json
RPZ_ZONE=rpz.local
RPZ_PUBLISH_MODE=artifact
RPZ_ARTIFACT_FILE=/data/rpz/rpz.local.db
# Only required when RPZ_PUBLISH_MODE=nsupdate
RPZ_PRIMARY=RPZ_PRIMARY
RPZ_PRIMARY_PORT=53
RPZ_KEY_FILE=/etc/bind/RPZ_MANAGER_KEY.key
