[Unit]
Description=DNSGuard API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dnsguard
Group=dnsguard
WorkingDirectory=/opt/dnsguard
EnvironmentFile=-/etc/dnsguard/dnsguard.env
ExecStart=/opt/dnsguard/.run/dnsguard-api
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/dnsguard /var/lib/dnsguard /var/log/dnsguard
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
