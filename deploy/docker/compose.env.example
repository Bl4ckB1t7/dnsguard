# Optional Compose interpolation overrides. The application configuration is
# stored in deploy/docker/dnsguard.env; these values only select local mounts
# and the published HTTPS port.
DNSGUARD_WEB_PORT=443
DNSGUARD_WEB_BIND_IP=127.0.0.1
DNSGUARD_DATA_DIR=./docker-data
DNSGUARD_SECRET_DIR=./secrets
DNSGUARD_TLS_DIR=./tls
DNSGUARD_BIND_LOG_DIR=./bind-logs
