# Safe input for scripts/rpz-connect.sh. This file contains no secret.
RPZ_ZONE=rpz.local
RPZ_PRIMARY=DNS_PRIMARY
RPZ_PRIMARY_PORT=53
RPZ_SECONDARIES=DNS_SECONDARY_1:53,DNS_SECONDARY_2:53
# Use a host path here, not the container path from dnsguard.env.
RPZ_KEY_FILE=/path/to/rpz-manager.key
# Optional recursive resolver used for actual policy-effect checks.
RPZ_RECURSOR=
# Optional fixed test name; it must be below this namespace. Leave empty to
# generate a random temporary name below the namespace.
RPZ_TEST_DOMAIN=
RPZ_TEST_NAMESPACE=_dnsguard-preflight.rpz.local

# Optional actual recursive-policy check. Set both values for PASS/FAIL validation.
RPZ_CHECK_NAME=
RPZ_EXPECTED_A=

# Optional allow-list validation. The name must be a known test name whose
# expected A result is controlled by the administrator.
RPZ_ALLOW_CHECK_NAME=
RPZ_ALLOW_EXPECTED_A=

# Optional TLD/default-deny validation. These checks are NOT RUN unless all
# values below are provided. The baseline resolver must return the expected A
# before the policy resolver is expected to return NXDOMAIN. RPZ_DENY_TRIGGER
# is an authoritative RPZ qname (for example com.RPZ_DENY_ZONE) and must show
# the exact CNAME . action; a bare NXDOMAIN is not treated as RPZ evidence.
RPZ_DENY_ZONE=
RPZ_DENY_CHECK_NAME=
RPZ_DENY_TRIGGER=
RPZ_DENY_EXPECTED_RCODE=NXDOMAIN
RPZ_DENY_BASELINE_RECURSOR=
RPZ_DENY_BASELINE_EXPECTED_A=
